# Supabase Configuration
SUPABASE_URL=https://peonzpcdvhymdtnhggeu.supabase.co
SUPABASE_KEY=your-supabase-key-here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.peonzpcdvhymdtnhggeu.supabase.co:5432/postgres

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SendGrid Email (https://sendgrid.com — free 100 emails/day, no domain needed)
# 1. Sign up at sendgrid.com
# 2. Settings → Sender Authentication → Single Sender Verification → verify your Gmail
# 3. Settings → API Keys → Create key
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=your-gmail@gmail.com

# App
FRONTEND_URL=http://localhost:5173
BATCH_SIZE=53
APP_NAME=PlacementHub
