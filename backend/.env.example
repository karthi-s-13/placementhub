# Supabase Configuration
SUPABASE_URL=https://peonzpcdvhymdtnhggeu.supabase.co
SUPABASE_KEY=your-supabase-key-here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.peonzpcdvhymdtnhggeu.supabase.co:5432/postgres

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Resend Email (https://resend.com — free, no SMTP port restrictions on Render)
# Sign up at resend.com → API Keys → Create key
RESEND_API_KEY=re_your_api_key_here
# After verifying your sending domain on Resend, set EMAIL_FROM:
EMAIL_FROM=PlacementHub <noreply@yourdomain.com>

# App
FRONTEND_URL=http://localhost:5173
BATCH_SIZE=53
APP_NAME=PlacementHub
